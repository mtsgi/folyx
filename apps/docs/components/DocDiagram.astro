---
import { diagramContent, type DiagramKind, type DocsLocale } from "./content.ts";

interface Props {
  kind: DiagramKind;
  locale?: DocsLocale;
}

const { kind, locale = "en" } = Astro.props;
const content = diagramContent[locale][kind];
const flow = kind === "providers" || kind === "ssr";
---

<figure class="folyx-diagram not-prose" data-doc-diagram={kind}>
  <figcaption>
    <strong>{content.title}</strong>
    <p>{content.description}</p>
  </figcaption>
  {
    kind === "overview" ? (
      <svg class="overview" viewBox="0 0 480 172" role="img" aria-label={content.title}>
        <title>{content.title}</title>
        <desc>{content.description}</desc>
        {[0, 1, 2].map((arrangement) => (
          <g transform={`translate(${arrangement * 160 + 10} 10)`}>
            <rect class="frame" x="0" y="0" width="140" height="148" rx="15" />
            {arrangement === 0 && <rect class="region" x="12" y="12" width="116" height="124" rx="8" />}
            {arrangement === 1 && <>
              <rect class="region" x="12" y="12" width="52" height="124" rx="8" />
              <rect class="region secondary" x="76" y="12" width="52" height="124" rx="8" />
            </>}
            {arrangement === 2 && <>
              <rect class="region" x="12" y="12" width="116" height="56" rx="8" />
              <rect class="region secondary" x="12" y="80" width="116" height="56" rx="8" />
            </>}
          </g>
        ))}
      </svg>
    ) : (
      <ol class:list={["cards", { flow }]}>
        {content.cards.map((card) => (
          <li>
            <svg viewBox="0 0 240 144" role="img" aria-label={card.title}>
              <title>{card.title}</title>
              <desc>{card.detail}</desc>
              {["single", "horizontal", "vertical", "complex", "unknown", "layout-frame", "visual-frame", "fallback", "derived"].includes(card.sketch) && <>
                <rect class="frame" x="16" y="16" width="208" height="112" rx="10" />
                {card.sketch === "single" && <rect class="region" x="28" y="28" width="184" height="88" rx="6" />}
                {["horizontal", "derived", "layout-frame"].includes(card.sketch) && <>
                  <rect class="region" x="28" y="28" width="84" height="88" rx="6" />
                  <rect class="region secondary" x="128" y="28" width="84" height="88" rx="6" />
                </>}
                {card.sketch === "vertical" && <>
                  <rect class="region" x="28" y="28" width="184" height="36" rx="6" />
                  <rect class="region secondary" x="28" y="80" width="184" height="36" rx="6" />
                </>}
                {card.sketch === "complex" && <>
                  <rect class="region" x="28" y="28" width="115" height="60" rx="6" />
                  <rect class="region secondary" x="97" y="58" width="115" height="58" rx="6" />
                </>}
                {card.sketch === "unknown" && <text x="120" y="83" class="question" text-anchor="middle">?</text>}
                {card.sketch === "layout-frame" && <>
                  <path class="line" d="M16 45V16h29" />
                  <circle class="point" cx="16" cy="16" r="4" />
                  <text x="24" y="12">(0, 0)</text>
                </>}
                {card.sketch === "visual-frame" && <>
                  <rect class="region dashed" x="56" y="48" width="144" height="68" rx="4" />
                  <path class="line" d="M16 16h40v32" stroke-dasharray="4 4" />
                  <circle class="point" cx="16" cy="16" r="4" />
                  <circle class="point" cx="56" cy="48" r="4" />
                  <text x="66" y="42">offset</text>
                </>}
                {card.sketch === "fallback" && <>
                  <rect class="region dashed" x="28" y="28" width="184" height="88" rx="6" />
                  <text x="120" y="79" text-anchor="middle">fallback</text>
                </>}
                {card.sketch === "derived" && <path class="line" d="M116 48h8m-8 48h8m-4-48v48" />}
              </>}
              {card.sketch === "sources" && <>
                {[0, 1, 2].map((index) => <>
                  <rect class="region" x="32" y={10 + index * 43} width="176" height="34" rx="7" />
                  <circle class="point" cx="52" cy={27 + index * 43} r="5" />
                  <path class="line" d={`M70 ${27 + index * 43}h114`} />
                </>)}
              </>}
              {["snapshot", "initial", "live", "observed", "cleanup"].includes(card.sketch) && <>
                <rect class="frame" x="40" y="12" width="160" height="120" rx="9" />
                <path class="line" d="M60 44h120M60 66h88M60 88h104M60 110h64" />
                {card.sketch === "initial" && <text class="status" x="181" y="120" text-anchor="end">?</text>}
                {card.sketch === "live" && <path class="check" d="m144 104 12 12 24-28" />}
                {card.sketch === "observed" && <circle class="signal" cx="174" cy="109" r="13" />}
                {card.sketch === "cleanup" && <>
                  <circle class="stop" cx="174" cy="109" r="17" />
                  <path class="line" d="m167 102 14 14m0-14-14 14" />
                </>}
              </>}
              {card.sketch === "application" && <>
                <rect class="frame" x="16" y="16" width="208" height="112" rx="10" />
                <path class="line" d="M16 40h208" />
                <rect class="region" x="28" y="52" width="56" height="64" rx="5" />
                <rect class="region secondary" x="96" y="52" width="116" height="64" rx="5" />
              </>}
            </svg>
            <strong>{card.title}</strong>
            <p>{card.detail}</p>
          </li>
        ))}
      </ol>
    )
  }
</figure>

<style>
  .folyx-diagram {
    margin: 1.75rem 0;
    padding: 1.25rem;
    border: 1px solid var(--blume-border);
    border-radius: var(--blume-radius);
    background: color-mix(in oklch, var(--blume-accent) 3%, var(--blume-background));
    color: var(--blume-foreground);
  }
  figcaption > strong { font-size: 1rem; }
  p { margin: 0.5rem 0 0; color: var(--blume-muted-foreground); font-size: 0.875rem; line-height: 1.75; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr)); gap: 1.25rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  li { position: relative; min-width: 0; }
  li > strong { display: block; font-size: 0.875rem; }
  .flow { grid-template-columns: minmax(0, 1fr); }
  .flow > li { display: grid; grid-template-columns: 5rem minmax(0, 1fr); column-gap: 1rem; align-items: start; }
  .flow > li > svg { grid-row: 1 / 3; align-self: center; }
  .flow > li > strong, .flow > li > p { grid-column: 2; }
  .flow > li:not(:last-child)::after { content: "↓"; display: block; grid-column: 2; margin-top: 0.5rem; color: var(--blume-accent); font-size: 1.25rem; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .overview { margin-top: 1.25rem; }
  .frame, .stop { fill: var(--blume-background); stroke: var(--blume-border); stroke-width: 2; }
  .region { fill: color-mix(in oklch, var(--blume-accent) 14%, var(--blume-background)); stroke: var(--blume-accent); stroke-width: 2; }
  .secondary { fill: color-mix(in oklch, var(--blume-accent) 5%, var(--blume-background)); }
  .dashed { stroke-dasharray: 6 4; }
  .line { fill: none; stroke: var(--blume-muted-foreground); stroke-width: 2; stroke-linecap: round; }
  text { fill: var(--blume-foreground); font-family: inherit; font-size: 16px; }
  .question { font-size: 40px; }
  .status { font-size: 24px; }
  .point, .signal { fill: var(--blume-accent); }
  .check { fill: none; stroke: var(--blume-accent); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
</style>
